---
import { PLANS } from '../data/plans';
import { SITE_CONFIG } from '../data/siteMeta';

export interface Props {
  showComparisonTable?: boolean;
}

const { showComparisonTable = true } = Astro.props;
---

<section class="pricing-section" id="plans">
  <div class="container">
    <div class="section-title-wrap">
      <div class="section-num">01 / PLANS & PRICING</div>
      <h2 class="section-title">WESTDATA 订阅套餐与流量方案</h2>
      <p class="section-subtitle">
        提供常规月度订阅与一次性备用流量包两大类方案。请结合实际上网习惯与设备量理性选择。
      </p>
    </div>

    <!-- 4 Plan Cards Grid -->
    <div class="plans-grid">
      {PLANS.map(plan => (
        <div class={`plan-card grid-box ${plan.isPopular ? 'popular-card' : ''}`}>
          <div class="grid-header">
            <div class="badge">{plan.period}</div>
            {plan.isPopular && <div class="popular-tag">PRO RECOMMENDED</div>}
          </div>

          <div class="plan-card-body">
            <h3 class="plan-name">{plan.name}</h3>
            
            <div class="plan-price-wrap">
              <span class="price-val">{plan.price}</span>
              <span class="price-period">/ {plan.period}</span>
            </div>

            <div class="data-limit-badge">
              <span class="data-val">{plan.dataLimit}</span>
              <span class="data-type">({plan.dataType})</span>
            </div>

            <p class="plan-target">{plan.recommendedFor}</p>

            <ul class="plan-feature-list">
              {plan.features.map(ft => (
                <li>
                  <span class="check-icon">✓</span>
                  <span>{ft}</span>
                </li>
              ))}
            </ul>

            <div class="plan-note">
              <span class="note-icon">ℹ</span> {plan.verificationNote}
            </div>

            <a
              href={SITE_CONFIG.buyUrl}
              target="_blank"
              rel="sponsored nofollow noopener"
              class={`btn btn-block ${plan.isPopular ? 'btn-orange' : 'btn-primary'}`}
            >
              前往开通套餐 →
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Independent Full Comparison Table -->
    {showComparisonTable && (
      <div class="comparison-wrap grid-box">
        <div class="grid-header">
          <div class="badge">TECHNICAL SPECIFICATIONS COMPARISON</div>
          <div>参考站数据维度核对</div>
        </div>
        <div class="table-responsive">
          <table class="comparison-table">
            <thead>
              <tr>
                <th>对比维度</th>
                {PLANS.map(p => (
                  <th>
                    <div class="th-name">{p.name}</div>
                    <div class="th-price">{p.price} / {p.period}</div>
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="field-label">流量额度</td>
                {PLANS.map(p => (
                  <td><strong>{p.dataLimit}</strong> ({p.dataType})</td>
                ))}
              </tr>
              <tr>
                <td class="field-label">速度描述核错状态</td>
                {PLANS.map(p => (
                  <td class="text-subtle">{p.speedLimit}</td>
                ))}
              </tr>
              <tr>
                <td class="field-label">设备在线数量声明</td>
                {PLANS.map(p => (
                  <td class="text-subtle">{p.deviceLimit}</td>
                ))}
              </tr>
              <tr>
                <td class="field-label">客户端兼容性</td>
                {PLANS.map(p => (
                  <td>{p.clients}</td>
                ))}
              </tr>
              <tr>
                <td class="field-label">AI 支持核实状态</td>
                {PLANS.map(p => (
                  <td class="text-subtle">{p.aiSupport}</td>
                ))}
              </tr>
              <tr>
                <td class="field-label">流媒体支持核实状态</td>
                {PLANS.map(p => (
                  <td class="text-subtle">{p.mediaSupport}</td>
                ))}
              </tr>
              <tr>
                <td class="field-label">选购通道</td>
                {PLANS.map(p => (
                  <td>
                    <a href={SITE_CONFIG.buyUrl} target="_blank" rel="sponsored nofollow noopener" class="btn btn-secondary btn-sm">
                      查阅结算页 →
                    </a>
                  </td>
                ))}
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    )}

  </div>
</section>

<style>
.pricing-section {
  padding: 4rem 0;
}

.plans-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1.5rem;
  margin-bottom: 3rem;
}

.plan-card {
  display: flex;
  flex-direction: column;
  height: 100%;
}

.popular-card {
  border-color: var(--color-accent-orange);
}

.popular-tag {
  font-family: var(--font-mono);
  font-size: 0.7rem;
  color: var(--color-accent-orange);
  font-weight: 700;
}

.plan-card-body {
  padding: 1.75rem 1.25rem;
  display: flex;
  flex-direction: column;
  flex-grow: 1;
}

.plan-name {
  font-size: 1.3rem;
  font-weight: 800;
  color: var(--color-warm-white);
  margin-bottom: 0.75rem;
}

.plan-price-wrap {
  display: flex;
  align-items: baseline;
  gap: 0.3rem;
  margin-bottom: 0.5rem;
}

.price-val {
  font-family: var(--font-mono);
  font-size: 2.2rem;
  font-weight: 900;
  color: var(--color-accent-green);
}

.price-period {
  font-size: 0.9rem;
  color: var(--color-silver);
}

.data-limit-badge {
  display: inline-flex;
  align-items: baseline;
  gap: 0.4rem;
  background: rgba(37, 43, 48, 0.7);
  padding: 0.4rem 0.75rem;
  border-radius: 2px;
  border: 1px solid var(--color-border);
  margin-bottom: 1rem;
  align-self: flex-start;
}

.data-val {
  font-family: var(--font-mono);
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--color-warm-white);
}

.data-type {
  font-size: 0.78rem;
  color: var(--color-silver);
}

.plan-target {
  font-size: 0.88rem;
  color: var(--color-silver);
  margin-bottom: 1.25rem;
  line-height: 1.4;
  min-height: 2.6em;
}

.plan-feature-list {
  list-style: none;
  padding: 0;
  margin-bottom: 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
  flex-grow: 1;
}

.plan-feature-list li {
  display: flex;
  align-items: flex-start;
  gap: 0.5rem;
  font-size: 0.88rem;
  color: #D1D5DB;
}

.check-icon {
  color: var(--color-accent-green);
  font-weight: bold;
}

.plan-note {
  font-size: 0.78rem;
  color: #8C969E;
  background: rgba(17, 20, 23, 0.6);
  padding: 0.6rem;
  border-left: 2px solid var(--color-silver);
  margin-bottom: 1.25rem;
  line-height: 1.4;
}

.note-icon {
  color: var(--color-accent-orange);
}

/* Comparison Table */
.comparison-wrap {
  margin-top: 3rem;
  margin-bottom: 2rem;
}

.table-responsive {
  overflow-x: auto;
}

.comparison-table {
  width: 100%;
  border-collapse: collapse;
  text-align: left;
  font-size: 0.9rem;
}

.comparison-table th, .comparison-table td {
  padding: 1rem 1.25rem;
  border-bottom: 1px solid var(--color-border);
  border-right: 1px solid var(--color-border);
}

.comparison-table th:last-child, .comparison-table td:last-child {
  border-right: none;
}

.comparison-table thead th {
  background: rgba(37, 43, 48, 0.5);
}

.th-name {
  font-size: 1rem;
  font-weight: 700;
  color: var(--color-warm-white);
}

.th-price {
  font-family: var(--font-mono);
  font-size: 0.85rem;
  color: var(--color-accent-green);
}

.field-label {
  font-weight: 600;
  color: var(--color-silver);
  white-space: nowrap;
  background: rgba(17, 20, 23, 0.4);
}

.text-subtle {
  font-size: 0.82rem;
  color: #9CA3AF;
}

.btn-sm {
  padding: 0.35rem 0.75rem;
  font-size: 0.8rem;
}

@media (max-width: 1100px) {
  .plans-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 650px) {
  .plans-grid {
    grid-template-columns: 1fr;
  }
}
</style>
